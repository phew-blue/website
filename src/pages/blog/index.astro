---
import Layout from '../../layouts/Layout.astro'
import Navigation from '../../components/Navigation.astro'
import PageHeader from '../../components/PageHeader.astro'
import EntryCard from '../../components/EntryCard.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter(p => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))

const [latest, ...rest] = posts

const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
const short = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
---
<Layout title="Blog — phew.blue">
  <Navigation />
  <main class="main">
    <div class="container">
      <PageHeader
        label="Blog"
        title="Notes"
        sub="Field notes from the homelab and broadcast kit — mostly the things that went wrong."
      />

      {latest && (
        <a href={`/blog/${latest.id}`} class="featured">
          <div class="featured-top">
            <div class="featured-info">
              <p class="featured-label">Latest</p>
              <h2 class="featured-name">{latest.data.title}</h2>
              {latest.data.description && <p class="featured-desc">{latest.data.description}</p>}
              <div class="tags">
                {latest.data.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            </div>
            <div class="featured-release">
              <div class="featured-date-lg">{fmt(latest.data.date)}</div>
              {latest.data.draft && <span class="draft">draft</span>}
            </div>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <section class="rest">
          <h2 class="rest-heading">Also</h2>
          <div class="grid">
            {rest.map(post => (
              <EntryCard
                href={`/blog/${post.id}`}
                title={post.data.title}
                description={post.data.description}
                tags={post.data.tags}
                badge={post.data.draft ? 'draft' : undefined}
                meta={short(post.data.date)}
              />
            ))}
          </div>
        </section>
      )}

      {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
    </div>
  </main>
</Layout>

<style>
  .main { min-height: 100vh; padding: 3rem 0 6rem; }
  .container { max-width: var(--measure); margin-inline: auto; padding-inline: var(--gutter); }

  /* Same panel as /software, so the two listing pages read as one design. */
  .featured {
    display: block; text-decoration: none;
    background: oklch(0.11 0.024 222); border: 1px solid oklch(0.70 0.12 218 / 18%);
    border-radius: 8px; padding: 2rem; margin-bottom: 2rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .featured:hover { border-color: oklch(0.70 0.12 218 / 45%); background: oklch(0.13 0.026 222); }
  .featured:hover .featured-name { color: oklch(0.70 0.12 218); }
  .featured-top { display: flex; gap: 2rem; justify-content: space-between; flex-wrap: wrap; }
  .featured-label { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: oklch(0.70 0.12 218); margin: 0 0 0.5rem; }
  .featured-name { font-size: 1.75rem; font-weight: 700; color: oklch(0.93 0.008 220); margin: 0 0 0.5rem; line-height: 1.2; transition: color 0.15s; }
  .featured-desc { font-size: 13px; color: oklch(0.60 0.030 220); line-height: 1.6; margin: 0 0 1rem; max-width: 60ch; }
  .featured-release { text-align: right; flex-shrink: 0; }
  .featured-date-lg { font-family: 'Courier New', monospace; font-size: 13px; color: oklch(0.70 0.12 218); }
  .draft { display: inline-block; font-family: 'Courier New', monospace; font-size: 9px; color: oklch(0.76 0.16 65); border: 1px solid oklch(0.76 0.16 65 / 30%); border-radius: 3px; padding: 1px 6px; margin-top: 0.5rem; }

  .rest { margin-top: 2rem; }
  .rest-heading { font-size: 1rem; font-weight: 600; color: oklch(0.70 0.030 220); margin: 0 0 1rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tag { font-size: 10px; font-family: 'Courier New', monospace; background: oklch(1 0 0 / 4%); border: 1px solid oklch(1 0 0 / 7%); color: oklch(0.55 0.022 220); border-radius: 3px; padding: 2px 8px; }
  .empty { font-size: 13px; color: oklch(0.50 0.020 220); }
</style>
