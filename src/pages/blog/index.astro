---
import Layout from '../../layouts/Layout.astro'
import Navigation from '../../components/Navigation.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter(p => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))

const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---
<Layout title="Blog — phew.blue">
  <Navigation />
  <main class="main">
    <div class="container">
      <header class="page-header">
        <span class="page-label">Blog</span>
        <h1 class="page-title">Notes</h1>
        <p class="page-sub">Field notes from the homelab and broadcast kit — mostly the things that went wrong.</p>
      </header>

      <ul class="post-list">
        {posts.map(post => (
          <li class="post-row">
            <a href={`/blog/${post.id}`} class="post-link">
              <div class="post-meta">
                <time class="post-date">{fmt(post.data.date)}</time>
                {post.data.draft && <span class="post-draft">draft</span>}
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              <div class="tags">
                {post.data.tags.map(t => <span class="tag tag--sm">{t}</span>)}
              </div>
            </a>
          </li>
        ))}
      </ul>

      {posts.length === 0 && <p class="empty">Nothing here yet.</p>}
    </div>
  </main>
</Layout>

<style>
  .main { min-height: 100vh; padding: 3rem 0 6rem; }
  .container { max-width: 760px; margin: 0 auto; padding: 0 2rem; }
  .page-header { margin-bottom: 3rem; }
  .page-label { display: block; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: oklch(0.70 0.12 218); margin-bottom: 0.75rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: oklch(0.93 0.008 220); margin: 0 0 0.75rem; }
  .page-sub { font-size: 14px; color: oklch(0.60 0.030 220); margin: 0; }

  .post-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .post-row { border-top: 1px solid oklch(1 0 0 / 7%); }
  .post-row:last-child { border-bottom: 1px solid oklch(1 0 0 / 7%); }
  .post-link { display: block; padding: 1.75rem 0; text-decoration: none; transition: opacity 0.15s; }
  .post-link:hover { opacity: 0.85; }
  .post-link:hover .post-title { color: oklch(0.70 0.12 218); }
  .post-meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
  .post-date { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: oklch(0.45 0.020 220); }
  .post-draft { font-family: 'Courier New', monospace; font-size: 9px; color: oklch(0.76 0.16 65); border: 1px solid oklch(0.76 0.16 65 / 30%); border-radius: 3px; padding: 1px 6px; }
  .post-title { font-size: 1.4rem; font-weight: 600; color: oklch(0.93 0.008 220); margin: 0 0 0.5rem; transition: color 0.15s; }
  .post-desc { font-size: 13px; color: oklch(0.60 0.030 220); line-height: 1.6; margin: 0 0 0.875rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tag { font-size: 10px; font-family: 'Courier New', monospace; background: oklch(1 0 0 / 4%); border: 1px solid oklch(1 0 0 / 7%); color: oklch(0.55 0.022 220); border-radius: 3px; padding: 2px 8px; }
  .tag--sm { font-size: 9px; padding: 1px 6px; }
  .empty { font-size: 13px; color: oklch(0.45 0.020 220); }
</style>
