---
import Layout from '../../layouts/Layout.astro'
import Navigation from '../../components/Navigation.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---
<Layout title={`${post.data.title} — phew.blue`}>
  <Navigation />
  <main class="main">
    <article class="container">
      <a href="/blog" class="back">&larr; Blog</a>
      <header class="post-header">
        <div class="post-meta">
          <time class="post-date">{fmt(post.data.date)}</time>
          {post.data.draft && <span class="post-draft">draft</span>}
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        {post.data.description && <p class="post-desc">{post.data.description}</p>}
        <div class="tags">
          {post.data.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .main { min-height: 100vh; padding: 2.5rem 0 6rem; }
  .container { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
  /* Same treatment as the software detail pages: the page uses the shared
     measure so the heading lines up with the nav, and only running prose is
     capped, since long lines of body text are what hurt readability. */
  .prose, .post-desc, .post-header { max-width: 820px; }
  .back { display: inline-block; font-size: 12px; color: oklch(0.60 0.030 220); text-decoration: none; margin-bottom: 2rem; transition: color 0.15s; }
  .back:hover { color: oklch(0.70 0.12 218); }
  .post-header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid oklch(1 0 0 / 8%); }
  .post-meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .post-date { font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: oklch(0.45 0.020 220); }
  .post-draft { font-family: 'Courier New', monospace; font-size: 9px; color: oklch(0.76 0.16 65); border: 1px solid oklch(0.76 0.16 65 / 30%); border-radius: 3px; padding: 1px 6px; }
  .post-title { font-size: clamp(1.75rem, 4.5vw, 2.6rem); font-weight: 700; color: oklch(0.93 0.008 220); margin: 0 0 0.875rem; line-height: 1.15; }
  .post-desc { font-size: 15px; color: oklch(0.62 0.030 220); line-height: 1.6; margin: 0 0 1.25rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tag { font-size: 10px; font-family: 'Courier New', monospace; background: oklch(1 0 0 / 4%); border: 1px solid oklch(1 0 0 / 7%); color: oklch(0.55 0.022 220); border-radius: 3px; padding: 2px 8px; }
</style>

<style is:global>
  .prose { font-size: 15px; line-height: 1.75; color: oklch(0.78 0.012 220); }
  .prose > * + * { margin-top: 1.25rem; }
  .prose h2 { font-size: 1.4rem; font-weight: 600; color: oklch(0.93 0.008 220); margin-top: 2.75rem; margin-bottom: 0; line-height: 1.3; }
  .prose h3 { font-size: 1.1rem; font-weight: 600; color: oklch(0.90 0.010 220); margin-top: 2rem; margin-bottom: 0; }
  .prose a { color: oklch(0.70 0.12 218); text-decoration: underline; text-underline-offset: 2px; }
  .prose strong { color: oklch(0.92 0.008 220); font-weight: 600; }
  .prose ul, .prose ol { padding-left: 1.4rem; }
  .prose li { margin-top: 0.4rem; }
  .prose li::marker { color: oklch(0.50 0.030 220); }
  .prose code { font-family: 'Courier New', monospace; font-size: 0.85em; background: oklch(1 0 0 / 5%); border: 1px solid oklch(1 0 0 / 8%); color: oklch(0.80 0.040 200); border-radius: 3px; padding: 1px 5px; }
  .prose pre { background: oklch(0.10 0.018 222); border: 1px solid oklch(1 0 0 / 8%); border-radius: 6px; padding: 1rem 1.25rem; overflow-x: auto; font-size: 13px; line-height: 1.6; }
  .prose pre code { background: none; border: none; padding: 0; color: oklch(0.75 0.020 200); font-size: 13px; }
  .prose blockquote { border-left: 2px solid oklch(0.70 0.12 218 / 40%); padding-left: 1rem; color: oklch(0.60 0.030 220); font-style: italic; }
  .prose hr { border: none; border-top: 1px solid oklch(1 0 0 / 8%); margin: 2.5rem 0; }
  .prose table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .prose th, .prose td { text-align: left; padding: 0.5rem 0.75rem; border: 1px solid oklch(1 0 0 / 8%); }
  .prose th { background: oklch(1 0 0 / 4%); color: oklch(0.85 0.010 220); font-weight: 600; }
</style>
