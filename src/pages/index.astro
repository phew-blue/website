---
import Layout from '../layouts/Layout.astro'
import BootSequence from '../components/BootSequence.astro'
import Navigation from '../components/Navigation.astro'
import SoftwareSection from '../components/SoftwareSection.astro'
import BlogSection from '../components/BlogSection.astro'
import ContactSection from '../components/ContactSection.astro'

const freelance = import.meta.env.PHEW_BLUE_FREELANCE === 'true'
---
<Layout>
  <BootSequence />
  <div id="page-content">
    <Navigation />
    <main id="main-content">
      {!freelance && <h1 class="sr-only">Robert Sumner — Broadcast Technology & Software</h1>}
      {freelance && (
        <section id="hero" class="hero">
          <div class="container">
            <p class="hero-label">VT · Edit Guarantee · Broadcast Technology</p>
            <h1 class="hero-title">Robert Sumner</h1>
            <p class="hero-desc">10+ years across live Outside Broadcast productions and post-production workflows. EVS, IP, UHD. Based in the UK.</p>
          </div>
        </section>
      )}
      <div class="home-columns">
        <SoftwareSection />
        <BlogSection />
      </div>
      <ContactSection />
    </main>
  </div>
</Layout>

<style>
  #page-content { min-height: 100vh; }
  /* The hero h1 only renders in freelance mode; this keeps a page h1 for
     screen readers and crawlers without changing the visual design. */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  /*
   * minmax(0, …) rather than a bare fr: grid items default to min-width:auto,
   * so the software column — whose rows carry a name, description, version and
   * date — refused to shrink, took 972px of the 1100px track, squeezed the blog
   * column to 397px and pushed the row off the right edge of the page.
   *
   * Software gets the wider share deliberately; it has far more per row.
   */
  .home-columns {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem; max-width: var(--measure); margin-inline: auto; padding: 3rem var(--gutter) 1rem;
    align-items: start;
  }
    /* minmax(0, …) here too: a bare 1fr keeps min-width:auto, and .repo-desc is
     white-space:nowrap, so the track refuses to shrink below its content and
     overflows the screen. */
  @media (max-width: 980px) {
    .home-columns { grid-template-columns: minmax(0, 1fr); gap: 3rem; padding: 3rem var(--gutter); }
  }
  .hero { padding: 6rem 0 3rem; }
  .container { max-width: var(--measure); margin-inline: auto; padding-inline: var(--gutter); }
  .hero-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: oklch(0.70 0.12 218); margin: 0 0 1rem; }
  .hero-title { font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 700; color: oklch(0.93 0.008 220); margin: 0 0 1rem; }
  .hero-desc { font-size: 16px; color: oklch(0.60 0.030 220); line-height: 1.7; max-width: 560px; margin: 0; }
</style>
