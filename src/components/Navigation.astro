---
const pathname = Astro.url.pathname
---
<div class="nav-bar">
<nav class="nav">
  <a href="/" class="nav-logo">
    <img src="/phew-blue-logo-website.svg" alt="phew.blue" class="nav-logo-img" />
  </a>
  <div class="nav-links">
    {/* Freelance-mode links (Work/Skills/About) were removed: /work and the
        #skills/#about anchors don't exist yet — reinstate them with the pages. */}
    <a href="/software" class:list={['nav-link', { active: pathname.startsWith('/software') }]}>Software</a>
    <a href="/blog" class:list={['nav-link', { active: pathname.startsWith('/blog') }]}>Blog</a>
    <a href="/#contact" class="nav-link">Contact</a>
  </div>
</nav>
</div>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: oklch(0.07 0.016 225 / 90%);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid oklch(1 0 0 / 8%);
  }
  .nav {
    position: relative;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Match the page measure so the logo shares a left edge with the content
       below it, while the bar background still spans the full viewport. */
    max-width: var(--measure);
    margin-inline: auto;
    width: 100%;
    padding-inline: var(--gutter);
    height: 56px;
    background: oklch(0.07 0.016 225 / 90%);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid oklch(1 0 0 / 8%);
  }
  .nav-logo { display: flex; align-items: center; text-decoration: none; }
  .nav-logo-img { height: 32px; width: auto; }
  .nav-links { display: flex; gap: 2rem; align-items: center; }
  .nav-link { font-size: 13px; color: oklch(0.60 0.030 220); text-decoration: none; transition: color 0.15s; }
  .nav-link:hover, .nav-link.active { color: oklch(0.93 0.008 220); }

  /* Narrow viewports: tighten the gaps first, and let the links drop onto
     their own row rather than crushing into the logo if they still don't fit.
     The bar's height stops being fixed here so a wrapped second row isn't
     clipped. 560px matches the --gutter breakpoint in global.css. */
  @media (max-width: 560px) {
    .nav {
      flex-wrap: wrap;
      height: auto;
      min-height: 56px;
      padding-block: 0.5rem;
      row-gap: 0.5rem;
    }
    .nav-logo-img { height: 28px; }
    .nav-links { gap: 1.25rem; flex-wrap: wrap; justify-content: flex-end; }
  }

  /* Once the links have wrapped they own the full row, so spread them across
     it instead of leaving them hugging the right edge under the logo. */
  @media (max-width: 380px) {
    .nav { justify-content: center; }
    .nav-links { width: 100%; justify-content: space-between; gap: 0.75rem; }
  }
</style>
