---
interface Props {
  label: string
  title: string
  sub?: string
}
const { label, title, sub } = Astro.props
---
<header class="page-header">
  <span class="page-label">{label}</span>
  <h1 class="page-title">{title}</h1>
  {sub && <p class="page-sub">{sub}</p>}
</header>

<style>
  .page-header { margin-bottom: 3rem; }
  .page-label { display: block; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: oklch(0.70 0.12 218); margin-bottom: 0.75rem; }
  .page-title { font-size: clamp(2rem, 4.5vw, 2.75rem); font-weight: 700; color: oklch(0.93 0.008 220); margin: 0 0 0.75rem; }
  .page-sub { font-size: 14px; color: oklch(0.60 0.030 220); margin: 0; }
</style>
