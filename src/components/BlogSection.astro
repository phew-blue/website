---
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 5)

const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })
---

<section id="blog" class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Blog</span>
      <h2 class="section-title">Latest</h2>
    </div>
    <div class="post-list">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="post-row">
          <span class="post-name">{post.data.title}</span>
          <span class="post-date">{fmt(post.data.date)}</span>
        </a>
      ))}
      {posts.length === 0 && <p class="empty">Nothing yet.</p>}
    </div>
    <div class="section-footer">
      <a href="/blog" class="view-all">View all →</a>
    </div>
  </div>
</section>

<style>
  .section { padding: 0; height: 100%; }
  .container { width: 100%; height: 100%; display: flex; flex-direction: column; }
  .section-header { margin-bottom: 2rem; }
  .section-label { display: block; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: oklch(0.70 0.12 218); margin-bottom: 0.5rem; }
  .section-title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: oklch(0.93 0.008 220); margin: 0; }
  .post-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .post-row {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    background: oklch(0.12 0.022 222); border: 1px solid oklch(1 0 0 / 6%);
    border-radius: 6px; padding: 0.875rem 1.25rem; text-decoration: none; transition: border-color 0.15s;
  }
  .post-row:hover { border-color: oklch(0.70 0.12 218 / 40%); }
  .post-row:hover .post-name { color: oklch(0.70 0.12 218); }
  .post-name { font-weight: 600; font-size: 12px; color: oklch(0.88 0.010 220); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color 0.15s; }
  .post-date { font-size: 12px; color: oklch(0.45 0.020 220); flex-shrink: 0; }

  /* Same as the software rows: nowrap clipped the title to an ellipsis on a
     phone. Stack and let it wrap. */
  @media (max-width: 560px) {
    .post-row { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .post-name { white-space: normal; overflow: visible; }
  }
  .empty { font-size: 12px; color: oklch(0.45 0.020 220); }
  .section-footer { margin-top: auto; padding-top: 1rem; text-align: right; }
  .view-all { font-size: 12px; color: oklch(0.70 0.12 218); text-decoration: none; }
</style>
